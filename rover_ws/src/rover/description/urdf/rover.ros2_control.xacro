<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Copied from: https://github.com/ros-controls/ros2_control_demos/blob/master/example_2/description/ros2_control/diffbot.ros2_control.xacro -->
  <xacro:macro name="rover_ros2_control" params="name use_gazebo:=^|false rw_rate:=30">     
    <ros2_control name="${name}/DiffDrive" type="system" rw_rate="${rw_rate}">
      <hardware>
        <!-- plugin to use in sim mode -->
        <xacro:if value="${use_gazebo}">
          <plugin>rover_hardware/DiffDrive</plugin>
        </xacro:if>

        <!-- otherwise, in real bot mode. -->
        <xacro:unless value="${use_gazebo}">
          <plugin>rover_hardware/DiffDrive</plugin>
          
          <param name="left_wheel_name">left_wheel_joint</param>
          <param name ="right_wheel_name">right_wheel_joint</param>
          <!--
          <param name ="loop_rate">30</param>
          <param name ="device">0</param>
          <param name ="baud_rate">0</param>
          <param name ="timeout">0</param>
          -->
        </xacro:unless>
      </hardware>

      <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>

