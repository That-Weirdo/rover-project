<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="tire_diam" value="0.259"/>
	<xacro:property name="tire_dist" value="0.752"/>
	<xacro:property name="tire_width" value="0.08"/>
	<xacro:property name="axle_offset" value="0.055"/>
	<xacro:property name="caster_axis_offset" value="0.07"/>
        <xacro:property name="caster_trail" value="0.045"/>

	<xacro:property name="base_width" value="0.615"/>
	<xacro:property name="base_length" value="1.22"/>
	<xacro:property name="base_thickness" value="0.02"/>
	<xacro:property name="base_lift" value="0.305"/> <!--Distance between ground and center of base-->

	<xacro:property name="PI" value="3.141592653"/>

	<xacro:property name="wheel_mass" value="2"/>
	<xacro:property name="wheel_friction" value="1.2"/>
	<xacro:property name="base_mass" value="15"/>

	<xacro:macro name="zero_origin">
		<origin xyz='0 0 0' rpy='0 0 0'/>
	</xacro:macro>


	<material name="wood">
		<color rgba="0.4 0.15 0.0 1" />
	</material>

	<material name="black">
		<color rgba="0.1 0.1 0.1 1" />
	</material>


        <link name='base_link'>
                <xacro:zero_origin/>
        </link>
	<joint name='base_to_chassis' type='fixed'>
		<parent link='base_link'/>
		<child link='chassis'/>
		<origin xyz='-${base_length / 2 - axle_offset} 0 ${base_lift}' rpy='0 0 0'/>
	</joint>
                
	<link name='chassis'>
		<visual>
                        <xacro:zero_origin/>
			<geometry>
				<box size="${base_length} ${base_width} ${base_thickness}"/>
			</geometry>
			<material name="wood"/>
		</visual>
		<collision>
                        <xacro:zero_origin/>
			<geometry>
				<box size="${base_length} ${base_width} ${base_thickness}"/>
			</geometry>
		</collision>
		<inertial>
                        <xacro:zero_origin/>
			<mass value="${base_mass}"/>
			<inertia ixx='0.1' ixy='0' ixz='0' iyy='0.2' iyz='0' izz='0.2'/>
		</inertial>
	</link>

        <joint name="chassis_to_chungus" type="fixed">
		<parent link='chassis'/>
		<child link='chungus_mass'/>
		<origin xyz='${base_length / 2 - axle_offset} 0 ${base_thickness / 2 + 0.1}' rpy='0 0 0'/>
	</joint>
                

        <link name="chungus_mass">
		<visual>
			<xacro:zero_origin/>
			<geometry>
				<box size="0.2 0.2 0.2"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<xacro:zero_origin/>
			<geometry>
				<box size="0.2 0.2 0.2"/>
			</geometry>
		</collision>
		<inertial>
			<xacro:zero_origin/>
			<mass value="10"/>
			<inertia ixx='0.3' ixy='0' ixz='0' iyy='0.3' iyz='0' izz='0.3'/>
		</inertial>
                
        </link>
                


	<!--TODO: NEEDS TO RUN ALONGSIDE JOINT_STATE_PUBLISHER-->

	<!-- left wheel -->
	<joint name='left_wheel_joint' type='continuous'>
		<origin xyz='${base_length/2 - axle_offset} ${tire_dist/2} -${base_lift - tire_diam/2}' rpy='-${PI/2} 0 0'/>
		<axis xyz='0 0 1'/>
		<parent link='chassis'/>
		<child link='left_wheel'/>
	</joint>

	<link name='left_wheel'>
		<visual>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
                        <surface>
                                <friction>
                                        <mu>0.9</mu>
                                        <mu2>0.9</mu2>
                                </friction>
                        </surface>
		</collision>
		<inertial>
			<xacro:zero_origin/>
			<mass value="${wheel_mass}"/>
			<inertia ixx='0.3' ixy='0' ixz='0' iyy='0.3' iyz='0' izz='0.5'/>
		</inertial>
	</link>

	<joint name='right_wheel_joint' type='continuous'>
		<origin xyz='${base_length/2 - axle_offset} -${tire_dist/2} -${base_lift - tire_diam/2}' rpy='-${PI/2} 0 0'/>
		<axis xyz='0 0 1'/>
		<parent link='chassis'/>
		<child link='right_wheel'/>
	</joint>

	<link name='right_wheel'>
		<visual>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
                        <surface>
                                <friction>
                                        <mu>0.9</mu>
                                        <mu2>0.9</mu2>
                                </friction>
                        </surface>
		</collision>
		<inertial>
			<xacro:zero_origin/>
			<mass value="${wheel_mass}"/>
			<inertia ixx='0.3' ixy='0' ixz='0' iyy='0.3' iyz='0' izz='0.5'/>
		</inertial>
	</link>

	<joint name='caster_axis' type='continuous'>
		<origin xyz='-${base_length/2 - caster_axis_offset} 0 0' rpy='0 0 0'/>
		<axis xyz='0 0 1'/>
		<parent link='chassis'/>
		<child link='caster_body'/>
	</joint>

	<!--caster wheel -->
        <link name='caster_body'>
                <!-- No visual for now -->
		<!-- Should probably have physics at least -->
		<inertial>
			<xacro:zero_origin/>
			<mass value="0.2"/>
			<inertia ixx='0.3' ixy='0' ixz='0' iyy='0.3' iyz='0' izz='0.1'/>
		</inertial>
        </link>



	<joint name='caster_wheel_joint' type='continuous'>
		<origin xyz='-${caster_trail} 0 -${base_lift - tire_diam/2}' rpy='-${PI/2} 0 0'/>
		<axis xyz='0 0 1'/>
		<parent link='caster_body'/>
		<child link='caster_wheel'/>
	</joint>

	<link name='caster_wheel'>
		<visual>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<xacro:zero_origin/>
			<geometry>
				<cylinder radius='${tire_diam / 2}' length='${tire_width}'/>
			</geometry>
                        <surface>
                                <friction>
                                        <mu>0.9</mu>
                                        <mu2>0.3</mu2>
                                </friction>
                        </surface>
		</collision>
		<inertial>
			<xacro:zero_origin/>
			<mass value="${wheel_mass}"/>
			<inertia ixx='0.3' ixy='0' ixz='0' iyy='0.3' iyz='0' izz='0.5'/>
		</inertial>
	</link>
	<!-- LIDAR -->
	<frame name="lidar_frame" attached_to='chassis'>
		<pose>0.8 0 0.5 0 0 0</pose>
	</frame>
</robot>
