<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="max">10</param>
            </command_interface>
            <state_interface name="veloity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="max">10</param>
            </command_interface>
            <state_interface name="veloity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

    <gazebo>
        <!--Actually contains controller_manager so we won't need to start our own-->
        <!--Otherwise need to run `ros2 run controller_manager ros2_control_node`-->
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control">
            <parameters>$(find articubot_one)/config/my_controllers.yaml</parameters>
        </plugin>

    </gazebo>


</robot>